#!/bin/sh
# TEMPORARY diagnostic: print the generated boot menu files into the build log.
echo "=====BOOTDUMP-BEGIN====="
pwd
find . -maxdepth 3 \( -path ./live -prune \) -o -print | grep -v -E '\.(mod|lst|o)$' | sort | head -200
for f in $(find . -maxdepth 4 \( -name '*.cfg' -o -name 'theme.txt' \) | sort); do
  echo "----- FILE $f"; cat "$f"
done
echo "=====BOOTDUMP-END====="
