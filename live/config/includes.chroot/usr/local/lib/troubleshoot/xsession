#!/bin/sh
# X session: no desktop, just the troubleshooter full screen. Openbox gives the bundled apps
# (Firefox, games...) title bars so they can be closed to get back to the troubleshooter.

# Apps like Firefox and Disks expect a D-Bus session bus.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    exec dbus-run-session -- "$0" "$@"
fi

xset s off -dpms s noblank 2>/dev/null

# With several screens attached, mirror them all onto the built-in one (or the first one),
# so the full-screen app covers exactly one display.
outputs=$(xrandr --query | awk '/ connected/ {print $1}')
primary=$(echo "$outputs" | grep -E '^(eDP|LVDS|DSI)' | head -n1)
[ -n "$primary" ] || primary=$(echo "$outputs" | head -n1)
for o in $outputs; do
    [ "$o" = "$primary" ] || xrandr --output "$o" --auto --same-as "$primary" 2>/dev/null
done
xrandr --output "$primary" --auto --primary 2>/dev/null

# Sound server, so speakers/microphones on modern laptops (SOF/UCM) are routed correctly.
export XDG_RUNTIME_DIR=/run/user/0
mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
pipewire >/var/log/pipewire.log 2>&1 &
sleep 0.5
wireplumber >/var/log/wireplumber.log 2>&1 &
pipewire-pulse >/var/log/pipewire-pulse.log 2>&1 &  # sound for Firefox and games

openbox --config-file /etc/troubleshoot/openbox-rc.xml >/var/log/openbox.log 2>&1 &

# The app creates this file once its window is up; without it the session falls back to text mode.
export TROUBLESHOOT_STARTED_FILE=/run/troubleshoot/gui-started
exec /usr/local/bin/troubleshoot
