#!/bin/sh
# live-build configuration for the Hardware Troubleshooter ISO.
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--archive-areas "main contrib non-free non-free-firmware" \
	--debian-installer none \
	--apt-recommends false \
	--chroot-squashfs-compression-type xz \
	--firmware-binary false \
	--firmware-chroot true \
	--memtest memtest86+ \
	--iso-application "Hardware Troubleshooter" \
	--iso-publisher "troubleshoot-iso" \
	--iso-volume "TROUBLESHOOT" \
	--bootappend-live "boot=live components quiet splash loglevel=3 noautologin nox11autologin hostname=troubleshoot" \
	--bootappend-live-failsafe "boot=live components noautologin nox11autologin hostname=troubleshoot nomodeset troubleshoot.text" \
	"${@}"
