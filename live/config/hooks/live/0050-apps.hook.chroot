#!/bin/sh
# Install the optional apps one by one so a missing or renamed package can't break the build.
set -e
export DEBIAN_FRONTEND=noninteractive
LIST=/usr/share/troubleshoot/apps.list
apt-get update -qq
missing=""
for pkg in $(sed -e 's/#.*//' "$LIST"); do
	if apt-get install -y -q --no-install-recommends "$pkg"; then
		echo "apps hook: installed $pkg"
	else
		echo "apps hook: WARNING: could not install $pkg, skipping"
		missing="$missing $pkg"
	fi
done
apt-get clean
echo "apps hook: done.${missing:+ Skipped:$missing}"
